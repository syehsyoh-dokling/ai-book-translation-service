# ─── SERVER ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────────
DB_PATH=./data/books.db

# ─── UPLOAD ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── AI AGENTS ────────────────────────────────────────────
# Isi minimal satu. Sistem otomatis fallback ke agent berikutnya.

# Claude (Anthropic) — RECOMMENDED default
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI GPT-4
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=xxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-pro

# Deepseek
DEEPSEEK_API_KEY=xxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ─── DEFAULT AGENT ────────────────────────────────────────
# Pilihan: claude | openai | gemini | deepseek
DEFAULT_AGENT=claude

# ─── TRANSLATION SETTINGS ─────────────────────────────────
# Ukuran chunk karakter per kiriman ke AI (override otomatis per agent)
# Kosongkan untuk pakai default per-agent
CHUNK_SIZE_OVERRIDE=

# Berapa halaman UI per chunk PDF (karakter ~2500 per halaman buku)
CHARS_PER_BOOK_PAGE=2500

# Pre-fetch halaman berikutnya di background?
ENABLE_PREFETCH=true
PREFETCH_PAGES_AHEAD=2
